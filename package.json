{
  "name": "coastline",
  "version": "1.0.17",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --import ./tests/world-seed.js --test tests/*.test.js",
    "test:browser": "node scripts/browser-test.mjs",
    "test:ao": "node scripts/ambient-occlusion-test.mjs",
    "test:traffic": "node scripts/traffic-test.mjs",
    "test:audio": "node scripts/audio-test.mjs",
    "review:audio": "node scripts/audio-review.mjs",
    "test:mobile": "node scripts/mobile-test.mjs",
    "test:graphics": "node scripts/graphics-test.mjs",
    "test:responsive": "node scripts/responsive-test.mjs",
    "test:controller": "node scripts/controller-test.mjs",
    "test:vr": "node scripts/vr-test.mjs",
    "test:scenery": "node scripts/scenery-test.mjs",
    "test:journeys": "node scripts/journey-test.mjs",
    "test:snow": "node scripts/snow-test.mjs",
    "test:jungle": "node scripts/jungle-test.mjs",
    "test:city": "node scripts/city-test.mjs",
    "test:generation": "node scripts/generation-test.mjs",
    "test:worker": "node scripts/worker-test.mjs",
    "electron:web": "vite build --outDir dist-electron",
    "electron:dev": "node scripts/electron-launch.mjs",
    "electron:start": "npm run electron:web && node scripts/electron-launch.mjs --built",
    "electron:icons": "node scripts/electron-icons.mjs",
    "electron:pack": "npm run electron:web && electron-builder --config electron/builder.config.cjs --dir",
    "electron:build": "npm run electron:web && electron-builder --config electron/builder.config.cjs --publish never",
    "electron:build:win": "npm run electron:web && electron-builder --config electron/builder.config.cjs --publish never --win --x64",
    "electron:build:linux": "npm run electron:web && electron-builder --config electron/builder.config.cjs --publish never --linux --x64",
    "electron:build:mac": "npm run electron:web && electron-builder --config electron/builder.config.cjs --publish never --mac",
    "test:electron": "node scripts/electron-test.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "n8ao": "2.0.1",
    "postprocessing": "^6.39.5",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.0"
  }
}
